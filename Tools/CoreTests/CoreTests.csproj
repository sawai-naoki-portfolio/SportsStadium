<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unity 非依存のテストだけを .NET で実行するためのプロジェクト。
       Assets 配下のファイルはコピーせずリンク参照する。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/SportsGame/Scripts/Runtime/Sports/Tennis/TennisScore.cs" Link="TennisScore.cs" />
    <Compile Include="../../Assets/SportsGame/Tests/EditMode/TennisScoreTests.cs" Link="TennisScoreTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
